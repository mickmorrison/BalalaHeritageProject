      <editFormConfig editorlayout="tablayout">
        <attributeEditorForm>
          <attributeEditorContainer name="Tab 1: 1. ID &amp; WHS Check" groupBox="0" columnCount="1">
            <attributeEditorContainer name="Header Metadata &amp; Geographic Context" groupBox="1" columnCount="2">
              <attributeEditorField name="structure_id"/>
              <attributeEditorField name="structure_name"/>
              <attributeEditorField name="property_name"/>
              <attributeEditorField name="recording_date"/>
              <attributeEditorField name="recorders"/>
              <attributeEditorField name="gnss_point_id"/>
              <attributeEditorField name="gnss_poly_id"/>
              <attributeEditorField name="site_plan_sheet_no"/>
              <attributeEditorField name="floor_plan_sheet_no"/>
              <attributeEditorField name="camera_make_number"/>
              <attributeEditorField name="photo_frame_range"/>
              <attributeEditorField name="overall_condition"/>
              <attributeEditorField name="sec1_comments"/>
            </attributeEditorContainer>
            <attributeEditorContainer name="Volunteer Safety &amp; WHS Pre-Entry Check (Check Before Entry)" groupBox="1" columnCount="2">
              <attributeEditorField name="whs_asbestos"/>
              <attributeEditorField name="whs_lead_paint"/>
              <attributeEditorField name="whs_unstable_struc"/>
              <attributeEditorField name="whs_chemical_haz"/>
              <attributeEditorField name="whs_biological_haz"/>
              <attributeEditorField name="whs_entry_status"/>
              <attributeEditorField name="sec2_whs_comments"/>
            </attributeEditorContainer>
          </attributeEditorContainer>
          <attributeEditorContainer name="Tab 2: 2–3. Layout &amp; Sub-Floor" groupBox="0" columnCount="1">
            <attributeEditorContainer name="Function, Scale &amp; Footprint Layout" groupBox="1" columnCount="2">
              <attributeEditorField name="orig_purpose"/>
              <attributeEditorField name="later_use"/>
              <attributeEditorField name="storeys_count"/>
              <attributeEditorField name="plan_shape"/>
              <attributeEditorField name="facade_symmetry"/>
              <attributeEditorField name="facade_orient"/>
              <attributeEditorField name="length_m"/>
              <attributeEditorField name="width_m"/>
              <attributeEditorField name="sec3_layout_comments"/>
            </attributeEditorContainer>
            <attributeEditorContainer name="Foundations &amp; Sub-Floor Space" groupBox="1" columnCount="2">
              <attributeEditorField name="footing_type"/>
              <attributeEditorField name="subfloor_timber"/>
              <attributeEditorField name="subfloor_deposit"/>
              <attributeEditorField name="sec4_found_comments"/>
            </attributeEditorContainer>
          </attributeEditorContainer>
          <attributeEditorContainer name="Tab 3: 4. Walls &amp; Framing" groupBox="0" columnCount="1">
            <attributeEditorContainer name="Wall Framing Systems, Joints &amp; Nails" groupBox="1" columnCount="2">
              <attributeEditorField name="wall_system_prim"/>
              <attributeEditorField name="wall_system_sec"/>
              <attributeEditorField name="timber_joints"/>
              <attributeEditorField name="fasteners_nails"/>
            </attributeEditorContainer>
            <attributeEditorContainer name="Masonry, Cladding &amp; External Finishes" groupBox="1" columnCount="2">
              <attributeEditorField name="brick_mfg_type"/>
              <attributeEditorField name="brick_bond"/>
              <attributeEditorField name="stone_coursing"/>
              <attributeEditorField name="mortar_type"/>
              <attributeEditorField name="quoins_type"/>
              <attributeEditorField name="ext_cladding_prim"/>
              <attributeEditorField name="ext_cladding_sec"/>
              <attributeEditorField name="ext_wall_finish"/>
              <attributeEditorField name="sec5_wall_comments"/>
            </attributeEditorContainer>
          </attributeEditorContainer>
          <attributeEditorContainer name="Tab 4: 5–6. Roof &amp; Openings" groupBox="0" columnCount="1">
            <attributeEditorContainer name="Roof Form, Verandahs &amp; Chimneys" groupBox="1" columnCount="2">
              <attributeEditorField name="roof_form"/>
              <attributeEditorField name="roof_cladding_cur"/>
              <attributeEditorField name="roof_early_clues"/>
              <attributeEditorField name="verandah_loc"/>
              <attributeEditorField name="verandah_profile"/>
              <attributeEditorField name="verandah_posts"/>
              <attributeEditorField name="verandah_status"/>
              <attributeEditorField name="chimney_count"/>
              <attributeEditorField name="chimney_material"/>
              <attributeEditorField name="chimney_location"/>
              <attributeEditorField name="sec6_roof_comments"/>
            </attributeEditorContainer>
            <attributeEditorContainer name="External Openings &amp; Hardware" groupBox="1" columnCount="2">
              <attributeEditorField name="window_type_prim"/>
              <attributeEditorField name="window_pane_cfg"/>
              <attributeEditorField name="door_type_prim"/>
              <attributeEditorField name="door_hardware"/>
              <attributeEditorField name="sec7_openings_comments"/>
            </attributeEditorContainer>
          </attributeEditorContainer>
          <attributeEditorContainer name="Tab 5: 7–9. Phasing, Marks &amp; Synthesis" groupBox="0" columnCount="1">
            <attributeEditorContainer name="Phasing &amp; Relative Chronology (Miles Lewis Building Developments)" groupBox="1" columnCount="1">
              <attributeEditorField name="sec8_phasing_comments"/>
              <attributeEditorRelation name="rel_structure_stages" relation="rel_structure_stages" showLabel="1" forceSuppressFormPopup="0">
                <editor_configuration type="Map">
                  <Option type="QString" name="buttons" value="AllButtons"/>
                </editor_configuration>
              </attributeEditorRelation>
            </attributeEditorContainer>
            <attributeEditorContainer name="Diagnostic Brands, Stamps &amp; Inscriptions" groupBox="1" columnCount="1">
              <attributeEditorRelation name="rel_structure_marks" relation="rel_structure_marks" showLabel="1" forceSuppressFormPopup="0">
                <editor_configuration type="Map">
                  <Option type="QString" name="buttons" value="AllButtons"/>
                </editor_configuration>
              </attributeEditorRelation>
            </attributeEditorContainer>
            <attributeEditorContainer name="General Synthesis &amp; Archaeological Integrity" groupBox="1" columnCount="2">
              <attributeEditorField name="fabric_intactness"/>
              <attributeEditorField name="assoc_refuse_dump"/>
              <attributeEditorField name="assoc_privy_cess"/>
              <attributeEditorField name="assoc_well_cistern"/>
              <attributeEditorField name="assoc_garden_lines"/>
              <attributeEditorField name="assoc_fence_lines"/>
              <attributeEditorField name="recorder_summary"/>
              <attributeEditorField name="sec9_synthesis_comments"/>
            </attributeEditorContainer>
          </attributeEditorContainer>
          <attributeEditorContainer name="Tab 6: Internal Rooms (Form 2)" groupBox="0" columnCount="1">
            <attributeEditorRelation name="rel_structure_rooms" relation="rel_structure_rooms" showLabel="1" forceSuppressFormPopup="0">
              <editor_configuration type="Map">
                <Option type="QString" name="buttons" value="AllButtons"/>
              </editor_configuration>
            </attributeEditorRelation>
          </attributeEditorContainer>
          <attributeEditorContainer name="Tab 7: Photos, Plans &amp; Scans" groupBox="0" columnCount="1">
            <attributeEditorContainer name="Direct Attached Photographs, Plans &amp; Scans" groupBox="1" columnCount="2">
              <attributeEditorField name="primary_facade_photo_path"/>
              <attributeEditorField name="site_plan_scan_path"/>
              <attributeEditorField name="floor_plan_scan_path"/>
              <attributeEditorField name="paper_form1_scan_path"/>
            </attributeEditorContainer>
            <attributeEditorContainer name="All Attached Media Files (Photographs, Plans, Scans)" groupBox="1" columnCount="1">
              <attributeEditorRelation name="rel_structure_media" relation="rel_structure_media" showLabel="1" forceSuppressFormPopup="0">
                <editor_configuration type="Map">
                  <Option type="QString" name="buttons" value="AllButtons"/>
                </editor_configuration>
              </attributeEditorRelation>
            </attributeEditorContainer>
          </attributeEditorContainer>
        </attributeEditorForm>
      </editFormConfig>
    </maplayer>

      <editFormConfig editorlayout="tablayout">
        <attributeEditorForm>
          <attributeEditorContainer name="Tab 1: Room ID &amp; Dimensions" groupBox="0" columnCount="1">
            <attributeEditorContainer name="Room Identification &amp; Context" groupBox="1" columnCount="2">
              <attributeEditorField name="structure_id"/>
              <attributeEditorField name="structure_name"/>
              <attributeEditorField name="room_id"/>
              <attributeEditorField name="room_name_or_letter"/>
              <attributeEditorField name="inferred_use"/>
              <attributeEditorField name="later_current_use"/>
              <attributeEditorField name="recording_date"/>
              <attributeEditorField name="recorders"/>
              <attributeEditorField name="gnss_point_poly_id"/>
              <attributeEditorField name="floor_plan_sheet_no"/>
              <attributeEditorField name="camera_make_number"/>
              <attributeEditorField name="photo_frame_range"/>
            </attributeEditorContainer>
            <attributeEditorContainer name="Internal Dimensions &amp; Floor Area" groupBox="1" columnCount="2">
              <attributeEditorField name="length_m"/>
              <attributeEditorField name="width_m"/>
              <attributeEditorField name="ceiling_height_m"/>
              <attributeEditorField name="floor_area_sqm"/>
              <attributeEditorField name="sec1_room_comments"/>
            </attributeEditorContainer>
          </attributeEditorContainer>
          <attributeEditorContainer name="Tab 2: Floor, Walls &amp; Ceiling" groupBox="0" columnCount="1">
            <attributeEditorContainer name="Floors &amp; Sub-Floor Access (Steel Rule Probe)" groupBox="1" columnCount="2">
              <attributeEditorField name="floor_material"/>
              <attributeEditorField name="board_width_mm"/>
              <attributeEditorField name="board_thickness_mm"/>
              <attributeEditorField name="floor_sawing_marks"/>
              <attributeEditorField name="subfloor_access_status"/>
              <attributeEditorField name="floor_condition"/>
              <attributeEditorField name="floor_comments"/>
            </attributeEditorContainer>
            <attributeEditorContainer name="Walls &amp; Internal Partitions (Linings &amp; Wallpaper)" groupBox="1" columnCount="2">
              <attributeEditorField name="wall_structure"/>
              <attributeEditorField name="wall_lining"/>
              <attributeEditorField name="wall_condition"/>
              <attributeEditorField name="wall_comments"/>
            </attributeEditorContainer>
            <attributeEditorContainer name="Ceilings &amp; Overhead Framing" groupBox="1" columnCount="2">
              <attributeEditorField name="ceiling_form"/>
              <attributeEditorField name="ceiling_cornice"/>
              <attributeEditorField name="ceiling_condition"/>
              <attributeEditorField name="ceiling_comments"/>
            </attributeEditorContainer>
          </attributeEditorContainer>
          <attributeEditorContainer name="Tab 3: Joinery, Services &amp; Scars" groupBox="0" columnCount="1">
            <attributeEditorContainer name="Internal Openings &amp; Joinery" groupBox="1" columnCount="2">
              <attributeEditorField name="internal_door_type"/>
              <attributeEditorField name="door_hardware"/>
              <attributeEditorField name="window_type"/>
              <attributeEditorField name="skirting_profile"/>
              <attributeEditorField name="skirting_height_mm"/>
              <attributeEditorField name="joinery_comments"/>
            </attributeEditorContainer>
            <attributeEditorContainer name="Fireplace, Stoves &amp; Fixed Services" groupBox="1" columnCount="2">
              <attributeEditorField name="fireplace_type"/>
              <attributeEditorField name="mantelpiece_type"/>
              <attributeEditorField name="fixed_fittings"/>
              <attributeEditorField name="services_utilities"/>
              <attributeEditorField name="services_comments"/>
            </attributeEditorContainer>
            <attributeEditorContainer name="Alterations, Scars &amp; Inscriptions" groupBox="1" columnCount="2">
              <attributeEditorField name="structural_scars"/>
              <attributeEditorField name="diagnostic_inscriptions"/>
              <attributeEditorField name="alterations_comments"/>
            </attributeEditorContainer>
          </attributeEditorContainer>
          <attributeEditorContainer name="Tab 4: Room Notes &amp; Scans" groupBox="0" columnCount="1">
            <attributeEditorField name="room_stratigraphic_summary"/>
            <attributeEditorField name="room_unstructured_notes"/>
            <attributeEditorField name="paper_form2_scan_path"/>
          </attributeEditorContainer>
          <attributeEditorContainer name="Tab 5: Room Objects Inventory (Form 3)" groupBox="0" columnCount="1">
            <attributeEditorRelation name="rel_room_objects" relation="rel_room_objects" showLabel="1" forceSuppressFormPopup="0">
              <editor_configuration type="Map">
                <Option type="QString" name="buttons" value="AllButtons"/>
              </editor_configuration>
            </attributeEditorRelation>
          </attributeEditorContainer>
        </attributeEditorForm>
      </editFormConfig>
    </maplayer>
